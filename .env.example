# Copy to `.env.local` and adjust. Vite only exposes variables prefixed
# with VITE_ to the client, and everything here ends up in the browser
# bundle — never put secrets in this file. The OpenAI API key lives in the
# server (see example-openai-server), not here.
#
# These are the *build-time* variables, used by `pnpm dev` and by builds you
# host statically. The published container image ignores them and reads
# API_BASE_URL and PUBLIC_URL when it starts instead — see compose.yaml.

# Base url of the backend. Defaults to http://localhost:3000 when unset.
VITE_API_BASE_URL=http://localhost:3000

# Public address this deployment is reachable at, without a trailing slash.
# Only used for the Open Graph tags in index.html, which need absolute urls.
# Unset falls back to http://localhost:5173, which is right for development
# and wrong for anything else. The special value `runtime` leaves the
# placeholder in place for the container entrypoint; that is what the
# Dockerfile sets, and you should not need it here.
VITE_PUBLIC_URL=http://localhost:5173
